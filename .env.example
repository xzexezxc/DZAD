PORT=3000
DATABASE_FILE=./data/cathprn.db
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Authorized proxy endpoints. For Webshare, paste the proxy URLs supplied by your account.
# Keep credentials in .env / secret manager, never in source control.
SCRAPER_PROXIES=
WEBSHARE_PROXY_URLS=
# Oxylabs Web Unblocker: credentials supplied by your Oxylabs account.
OXYLABS_WEB_UNBLOCKER_USERNAME=
OXYLABS_WEB_UNBLOCKER_PASSWORD=
OXYLABS_WEB_UNBLOCKER_ENDPOINT=unblock.oxylabs.io:60000
# Geo-targeting requested from the Oxylabs account, defaulting to France.
OXYLABS_GEO_LOCATION=France
OXYLABS_WEB_UNBLOCKER_SESSION_ID=
SCRAPER_CONCURRENCY=2
SCRAPER_MAX_RETRIES=3
SCRAPER_BASE_BACKOFF_MS=1000
SCRAPER_MAX_BACKOFF_MS=30000
SCRAPER_DELAY_MS=1500
MAX_WORKER_QUEUE=20
# Explicitly opt into a visible browser for troubleshooting; default remains headless.
SCRAPER_HEADLESS=true
# The application cannot create a host VPN tunnel itself. Route worker egress through WireGuard/OpenVPN at deployment level.
SCRAPER_EGRESS_INTERFACE=
