PORT=3000
DATABASE_FILE=./data/cathprn.db
# Generate with: openssl rand -hex 32
CREDENTIAL_ENCRYPTION_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated authorized proxy endpoints; leave empty to connect directly
SCRAPER_PROXIES=
SCRAPER_CONCURRENCY=2
SCRAPER_MAX_RETRIES=3
SCRAPER_BASE_BACKOFF_MS=1000
SCRAPER_MAX_BACKOFF_MS=30000
SCRAPER_DELAY_MS=1500
MAX_WORKER_QUEUE=20
